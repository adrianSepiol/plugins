{
  "name": "@perses-dev/expression-plugin",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "homepage": "https://github.com/perses/plugins/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perses/plugins.git"
  },
  "bugs": {
    "url": "https://github.com/perses/plugins/issues"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "npm run build-mf && concurrently \"npm:build:*\"",
    "build-mf": "rsbuild build",
    "build:esm": "swc ./src -d dist/lib --strip-leading-paths --config-file ../.swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "oxlint src",
    "test": "cross-env LC_ALL=C TZ=UTC vitest run",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@perses-dev/client": "^0.55.0",
    "@perses-dev/plugin-system": "^0.55.0",
    "@perses-dev/spec": "^0.3.0",
    "immer": "^10.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "files": [
    "lib/**/*",
    "__mf/**/*",
    "mf-manifest.json",
    "mf-stats.json"
  ],
  "perses": {
    "metadata": {
      "name": "Expression",
      "registry": "perses-dev"
    },
    "schemasPath": "schemas",
    "plugins": [
      {
        "kind": "TimeSeriesQuery",
        "spec": {
          "display": {
            "name": "Expression",
            "description": "Math expression computed on the other time series queries of the panel"
          },
          "name": "ExpressionQuery"
        }
      }
    ]
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1"
  }
}

